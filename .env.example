# Copy this file to .env before running the app, then fill in real values.
# Never commit a real .env file with actual secrets to version control.
# SECRET_KEY, DEFAULT_ADMIN_EMAIL and DEFAULT_ADMIN_PASSWORD are REQUIRED —
# the app will refuse to start with a clear configuration error if any of
# them are missing. There are no hardcoded/default fallback values.

# Required for every AI feature (Career Coach, Resume Coach, Interview
# Coach, Coding Assistant, Study Assistant, Skill Gap Analyzer, Career
# Roadmap, Group Discussion simulator, AI Quiz Generator, Company Prep).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# REQUIRED. Flask session secret used to sign cookies — set a long,
# random, unique value. The app will not start without this.
SECRET_KEY=your_strong_secret_key_here

# REQUIRED. Credentials for the admin account created automatically the
# first time the database is created (see models/db.py). Choose a real
# email you control and a strong, unique password. The app will not
# start without these.
DEFAULT_ADMIN_EMAIL=your_admin_email_here
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password_here

# Optional: cloud platforms set PORT automatically; leave unset locally.
# PORT=5000

# Optional: set to "true" to enable Flask's debugger locally. Never set
# this in production — it allows arbitrary code execution via the
# in-browser debugger if an error page is ever reached.
# FLASK_DEBUG=false
